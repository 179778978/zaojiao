{
  "name": "xiaoya-zaojiao",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mobile": "expo start --config app.json",
    "mobile:ios": "expo start --ios --config app.json",
    "mobile:android": "expo start --android --config app.json",
    "mobile:typecheck": "tsc --project tsconfig.mobile.json",
    "dev": "next dev",
    "build": "next build && pagefind --site out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "content:check": "node --import tsx scripts/check-content.ts",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~54.0.0",
    "expo-font": "~14.0.0",
    "expo-localization": "~17.0.0",
    "expo-status-bar": "~3.0.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.12",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^27.0.1",
    "pagefind": "^1.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
